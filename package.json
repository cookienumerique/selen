  "version": "1.0.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write . --config .prettierrc",
    "start": "npx expo start --dev-client --reset-cache",
    "build:local:android": "eas build --platform android --profile development --local",
    "build:local:ios": "eas build --platform ios --profile development --local --clear-cache",
    "build:production:android": "eas build --platform android --profile production --local",
    "build:production:ios": "eas build --platform ios --profile production --local --clear-cache",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
